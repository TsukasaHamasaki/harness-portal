{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-portal.local/schema/harness.schema.json",
  "title": "Claude Harness Portal snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportedAt",
    "exporter",
    "environment",
    "counts",
    "skills",
    "agents",
    "mcpServers",
    "plugins",
    "commands",
    "hooks",
    "permissions",
    "claudeMd",
    "settings",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "exporter": { "$ref": "#/$defs/exporter" },
    "environment": { "$ref": "#/$defs/environment" },
    "counts": { "$ref": "#/$defs/counts" },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } },
    "mcpServers": { "type": "array", "items": { "$ref": "#/$defs/mcpServer" } },
    "plugins": { "type": "array", "items": { "$ref": "#/$defs/plugin" } },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "hooks": { "type": "array", "items": { "$ref": "#/$defs/hook" } },
    "permissions": { "$ref": "#/$defs/permissions" },
    "recipes": { "type": "array", "items": { "$ref": "#/$defs/recipe" } },
    "claudeMd": { "$ref": "#/$defs/claudeMd" },
    "settings": { "$ref": "#/$defs/settings" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "category": {
      "enum": [
        "browser",
        "docs",
        "media",
        "transcribe",
        "writing",
        "ec",
        "gws",
        "notion",
        "web",
        "research",
        "dev",
        "data",
        "comm",
        "other",
        null
      ]
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "classifier"],
      "properties": {
        "kind": { "enum": ["cli", "paste"] },
        "version": { "type": "string" },
        "classifier": { "enum": ["agent", "rule", "none"] }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "claudeVersion", "model", "language"],
      "properties": {
        "os": { "type": "string" },
        "claudeVersion": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "language": { "type": ["string", "null"] }
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "agents", "mcpServers", "plugins", "commands"],
      "properties": {
        "skills": { "$ref": "#/$defs/count" },
        "agents": { "$ref": "#/$defs/count" },
        "mcpServers": { "$ref": "#/$defs/count" },
        "plugins": { "$ref": "#/$defs/count" },
        "commands": { "$ref": "#/$defs/count" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "scope", "triggers", "category"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "scope": { "enum": ["user", "project", "plugin"] },
        "triggers": { "type": "array", "items": { "type": "string" } },
        "category": { "$ref": "#/$defs/category" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "tools", "model", "category"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "model": { "type": ["string", "null"] },
        "category": { "$ref": "#/$defs/category" }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "transport", "status", "category"],
      "properties": {
        "id": { "type": "string" },
        "scope": { "enum": ["global", "project", "connector"] },
        "transport": { "enum": ["stdio", "http", "sse"] },
        "commandSummary": { "type": "string" },
        "host": { "type": "string" },
        "status": { "enum": ["connected", "needs-auth", "failed", "unknown"] },
        "category": { "$ref": "#/$defs/category" }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "marketplace", "version", "enabled", "installedAt"],
      "properties": {
        "id": { "type": "string" },
        "marketplace": { "type": "string" },
        "version": { "type": "string" },
        "enabled": { "type": "boolean" },
        "installedAt": { "type": "string" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope"],
      "properties": {
        "id": { "type": "string" },
        "scope": { "enum": ["user", "project", "plugin"] }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "count"],
      "properties": {
        "event": { "type": "string" },
        "count": { "$ref": "#/$defs/count" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultMode", "allowCount", "categories"],
      "properties": {
        "defaultMode": { "type": ["string", "null"] },
        "allowCount": { "$ref": "#/$defs/count" },
        "categories": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/count" }
        }
      }
    },
    "claudeMd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "sections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recipeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "itemIds"],
      "properties": {
        "phase": { "type": "string" },
        "itemIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "steps"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/recipeStep" } }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effortLevel", "envKeyNames"],
      "properties": {
        "model": { "type": ["string", "null"] },
        "effortLevel": { "type": ["string", "null"] },
        "envKeyNames": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
